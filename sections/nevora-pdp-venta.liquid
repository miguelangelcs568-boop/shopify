{{ 'nevora-nocturne.css' | asset_url | stylesheet_tag }}

<section class="nv-pdp" id="nv-pdp-venta">
  <div class="nv-pdp__wrap page-width">
    <div class="nv-guide">
      <p class="nv-eyebrow">Cómo pedir · pago contra entrega</p>
      <h2>No pagas ahora. Pagas cuando el pedido llega.</h2>
      <ol class="nv-guide__steps">
        <li>
          <strong>Agregar al carrito</strong>
          <span>En esta página, elige la cantidad y pulsa Agregar al carrito.</span>
        </li>
        <li>
          <strong>Ir al carrito</strong>
          <span>Abre el carrito y revisa el producto y el total.</span>
        </li>
        <li>
          <strong>Pagar ahora</strong>
          <span>Pulsa Pagar ahora. No te cobra en ese momento.</span>
        </li>
        <li>
          <strong>Tus datos</strong>
          <span>Nombre, cédula, celular, ciudad y dirección de entrega.</span>
        </li>
        <li>
          <strong>Método de pago</strong>
          <span>En método de pago elige Pago contra entrega. Confirmas el pedido y listo.</span>
        </li>
      </ol>
      <p class="nv-guide__note">El mensajero llega con guía. Revisas el paquete y pagas en la puerta. Si no llega, no hay cobro.</p>
      <a class="button nv-pdp__cta" href="#nv-buy">Agregar y pagar al recibir</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .nv-guide {
    margin: 28px 0 48px;
    padding: 28px;
    border: 1px solid rgba(17,17,17,.1);
    border-radius: 16px;
    background: #fff;
  }
  .nv-guide h2 {
    margin: 6px 0 18px;
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -.03em;
    line-height: 1.1;
  }
  .nv-guide__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .nv-guide__steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 4px 12px;
    padding: 12px 0;
    border-top: 1px solid rgba(17,17,17,.08);
  }
  .nv-guide__steps li::before {
    content: counter(step);
    counter-increment: step;
  }
  .nv-guide__steps { counter-reset: step; }
  .nv-guide__steps li::before {
    grid-row: 1 / span 2;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 650;
  }
  .nv-guide__steps strong { font-size: 16px; }
  .nv-guide__steps span { color: #444; font-size: 14px; }
  .nv-guide__note { margin: 16px 0; color: #333; }
  .nv-pdp__cta { margin-top: 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Guía contra entrega",
  "tag": "section",
  "class": "section-nv-pdp",
  "settings": [],
  "presets": [
    { "name": "Guía contra entrega" }
  ]
}
{% endschema %}
